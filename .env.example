# =============================================================================
# SmartTrompa Frontend — Variables de Entorno
# =============================================================================
# Copiar a `.env.local` y completar. NUNCA commitear `.env*` con valores reales.
# Referencia completa: SmartTrompa/docs/ops/2026-07-10-configuracion-produccion.md
#
# BUILD-TIME vs RUNTIME: las NEXT_PUBLIC_* se hornean en los bundles al hacer
# `next build` — cambiarlas exige rebuild de la imagen Docker, no basta
# reiniciar el contenedor. JWT_SECRET y COOKIE_DOMAIN son runtime.
# =============================================================================

# --- API Backend (BUILD-TIME, obligatoria) ---
# URL base del backend Spring Boot (sin trailing slash). El build de Docker
# aborta si falta y MOCK_MODE no es true.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Mock mode (BUILD-TIME) ---
# true → frontend usa datos estáticos sin tocar backend, el login acepta
#        cualquier credencial (SOLO para demos de UI locales, nunca público).
# false → app conecta al backend real. En el deploy el compose lo hornea "false".
NEXT_PUBLIC_MOCK_MODE=false

# --- JWT (RUNTIME, server-side / Edge) ---
# Mismo valor que el backend (firma vs verificación). Generar con: openssl rand -base64 64
# NO se inyecta en bundles cliente — solo lo usa el middleware en Edge runtime.
# ⚠️ Si falta, la app NO crashea: entra en loop de login (limpia cookies y
# redirige a /login en cada request).
JWT_SECRET=

# --- Cookies entre subdominios (RUNTIME, opcional) ---
# Atributo Domain de las cookies de sesión para compartirlas entre el dominio
# del frontend y el del backend (ej: .c4i-udec.cl). Vacío = cookie host-only.
# En el deploy real la fija el docker-compose.yml.
COOKIE_DOMAIN=

# --- Marca (BUILD-TIME, opcionales; solo dev local) ---
# En el deploy Docker NO son configurables (el Dockerfile no tiene ARG para
# ellas): siempre aplican los defaults del Header.
# NEXT_PUBLIC_BRAND_NAME=Compañía Minera Universidad de Concepción
# NEXT_PUBLIC_BRAND_LOGO=/brand-logo.png

# --- Puerto del host ---
# El docker-compose.yml publica el frontend en 10801:3000 (hardcodeado).
# No hay variable de entorno para cambiarlo: editar el compose si hace falta.
