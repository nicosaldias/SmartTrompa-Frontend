# =============================================================================
# SmartTrompa Frontend — Variables de Entorno
# =============================================================================
# Copiar a `.env.local` y completar. NUNCA commitear `.env*` con valores reales.
# =============================================================================

# --- API Backend ---
# URL base del backend Spring Boot (sin trailing slash). Se "bake" en build time.
# Si NEXT_PUBLIC_MOCK_MODE=true, esta var puede quedar vacía.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Mock mode ---
# true → frontend usa datos estáticos sin tocar backend (solo para demos UI).
# false → app conecta al backend real (default en producción).
NEXT_PUBLIC_MOCK_MODE=false

# --- JWT (runtime, server-side / Edge) ---
# Mismo valor que el backend (firma vs verificación). Generar con: openssl rand -base64 64
# NO se inyecta en bundles cliente — solo lo usa el middleware en Edge runtime.
JWT_SECRET=

# --- Deploy con docker-compose ---
# Puerto del host donde se publica el frontend (mapeado al 3000 del contenedor).
# Lo usa docker-compose.yml. En el deploy por GitHub Actions viene de un Secret.
FRONTEND_HOST_PORT=3000
