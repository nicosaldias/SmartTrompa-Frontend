# =============================================================================
# SmartTrompa Frontend — Variables de Entorno
# =============================================================================
# Copiar a `.env.local` y completar. NUNCA commitear `.env*` con valores reales.
# Referencia completa: SmartTrompa/docs/ops/2026-07-10-configuracion-produccion.md
#
# BUILD-TIME vs RUNTIME: las NEXT_PUBLIC_* se hornean en los bundles al hacer
# `next build` — cambiarlas exige rebuild de la imagen Docker, no basta
# reiniciar el contenedor. COOKIE_DOMAIN es runtime.
# =============================================================================

# --- API Backend (BUILD-TIME, obligatoria) ---
# URL base del backend Spring Boot (sin trailing slash). El build de Docker
# aborta si falta y MOCK_MODE no es true.
# DEBE terminar en /api: src/api/endpoints.ts concatena las rutas a este valor.
# El WebSocket de tiempo real se deriva reemplazando el path, no agregándolo:
# https://api.midominio.cl/api  →  wss://api.midominio.cl/ws
# Por eso Nginx necesita location para /api y para /ws por separado.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Mock mode (BUILD-TIME) ---
# true → frontend usa datos estáticos sin tocar backend, el login acepta
#        cualquier credencial (SOLO para demos de UI locales, nunca público).
# false → app conecta al backend real. En el deploy el compose lo hornea "false".
NEXT_PUBLIC_MOCK_MODE=false

# --- JWT --- OBSOLETA, no la definas ---
# El middleware dejó de verificar la firma del token: la autorización real vive
# en el backend, que la comprueba en cada request. Tener el secreto de firma en
# el frontend significaba que comprometerlo permitía emitir tokens válidos de
# cualquier usuario, incluido Administrador. Ni el compose ni el workflow la
# inyectan. Se deja anotada para que nadie la reintroduzca "porque faltaba".
# JWT_SECRET=

# --- Cookies entre subdominios (RUNTIME) ---
# Atributo Domain de las cookies de sesión, para que valgan tanto en el
# subdominio de la app como en el del API (ej: .midominio.cl).
# Vacío = cookie host-only, que es lo correcto en local.
# En producción es OBLIGATORIA y viene del Secret COOKIE_DOMAIN: si falta, el
# navegador descarta la cookie y el login falla sin mostrar ningún error. El
# workflow de deploy verifica que exista antes de construir.
COOKIE_DOMAIN=

# --- Marca (BUILD-TIME, opcionales; solo dev local) ---
# En el deploy Docker NO son configurables (el Dockerfile no tiene ARG para
# ellas): siempre aplican los defaults del Header.
# NEXT_PUBLIC_BRAND_NAME=Compañía Minera Universidad de Concepción
# NEXT_PUBLIC_BRAND_LOGO=/brand-logo.png

# --- Puerto del host ---
# El docker-compose.yml publica el frontend en 127.0.0.1:10801:3000 (hardcodeado).
# Solo loopback a propósito: quien expone la app al exterior es Nginx, con TLS.
# No hay variable de entorno para cambiarlo: editar el compose si hace falta.
